<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.preference.PreferenceCategory
        android:title="Apariencia"> <androidx.preference.ListPreference
        app:key="theme_pref"
        android:title="Tema de la aplicación"
        android:summary="Selecciona el aspecto visual"
        app:entries="@array/theme_options"
        app:entryValues="@array/theme_values"
        app:defaultValue="dark" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="Localización">

        <androidx.preference.ListPreference
            app:key="lang_pref"
            android:title="Idioma"
            android:summary="Selecciona tu lenguaje"
            app:entries="@array/lang_options"
            app:entryValues="@array/lang_values"
            app:defaultValue="es" />
    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>